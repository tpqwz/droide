procedure Open();
begin
  if ReadText('newest') = '1' then
    NewestCheck.Checked := true
  else
    NewestCheck.Checked := false
  if ReadText('scope') = '0' then
    ScopeCheck.Checked := false
  else
    ScopeCheck.Checked := true
  if ReadText('theme') = '' then
    ThemeSpin.Selection := 1
  else
    ThemeSpin.Selection := StrToInt(ReadText('theme'))
  if ReadText('scheme') = '' then
    SchemeSpin.Selection := 0
  else
    SchemeSpin.Selection := StrToInt(ReadText('scheme'))
  if ReadText('face') = '' then
    FaceSpin.Selection := 0
  else
    FaceSpin.Selection := StrToInt(ReadText('face'))
  if ReadText('language') = '' then
    LangSpin.Selection := 0
  else
    LangSpin.Selection := StrToInt(ReadText('language'))
  Paint()
  ShowCounts()
end;

procedure NewestClick();
begin
  if NewestCheck.Checked then
    WriteText('newest', '1')
  else
    WriteText('newest', '0')
end;

procedure ScopeClick();
begin
  if ScopeCheck.Checked then
    WriteText('scope', '1')
  else
    WriteText('scope', '0')
end;

procedure CloseClick();
begin
  Finish()
end;

procedure Paint();
begin
  if ReadText('share') = 'add' then begin
    ShareAdd.Color := $FF1F6B4A
    ShareAdd.TextColor := $FFF3FAF6
    ShareEdit.Color := $FFFBF8F2
    ShareEdit.TextColor := $FF1C1915
  end else begin
    ShareEdit.Color := $FF1F6B4A
    ShareEdit.TextColor := $FFF3FAF6
    ShareAdd.Color := $FFFBF8F2
    ShareAdd.TextColor := $FF1C1915
  end
  if ReadText('search') = 'e5' then begin
    SearchE5.Color := $FF1F6B4A
    SearchE5.TextColor := $FFF3FAF6
    SearchOff.Color := $FFFBF8F2
    SearchOff.TextColor := $FF1C1915
    SearchGemma.Color := $FFFBF8F2
    SearchGemma.TextColor := $FF1C1915
  end else if ReadText('search') = 'gemma' then begin
    SearchGemma.Color := $FF1F6B4A
    SearchGemma.TextColor := $FFF3FAF6
    SearchOff.Color := $FFFBF8F2
    SearchOff.TextColor := $FF1C1915
    SearchE5.Color := $FFFBF8F2
    SearchE5.TextColor := $FF1C1915
  end else begin
    SearchOff.Color := $FF1F6B4A
    SearchOff.TextColor := $FFF3FAF6
    SearchE5.Color := $FFFBF8F2
    SearchE5.TextColor := $FF1C1915
    SearchGemma.Color := $FFFBF8F2
    SearchGemma.TextColor := $FF1C1915
  end
  if ReadText('hand') = 'left' then begin
    HandLeft.Color := $FF1F6B4A
    HandLeft.TextColor := $FFF3FAF6
    HandRight.Color := $FFFBF8F2
    HandRight.TextColor := $FF1C1915
  end else begin
    HandRight.Color := $FF1F6B4A
    HandRight.TextColor := $FFF3FAF6
    HandLeft.Color := $FFFBF8F2
    HandLeft.TextColor := $FF1C1915
  end
  if ReadText('toolbar') = 'strip' then begin
    BarStrip.Color := $FF1F6B4A
    BarStrip.TextColor := $FFF3FAF6
    BarFloat.Color := $FFFBF8F2
    BarFloat.TextColor := $FF1C1915
  end else begin
    BarFloat.Color := $FF1F6B4A
    BarFloat.TextColor := $FFF3FAF6
    BarStrip.Color := $FFFBF8F2
    BarStrip.TextColor := $FF1C1915
  end
  if ReadText('enter') = 'return' then begin
    EnterAdd.Color := $FF1F6B4A
    EnterAdd.TextColor := $FFF3FAF6
    EnterShift.Color := $FFFBF8F2
    EnterShift.TextColor := $FF1C1915
  end else begin
    EnterShift.Color := $FF1F6B4A
    EnterShift.TextColor := $FFF3FAF6
    EnterAdd.Color := $FFFBF8F2
    EnterAdd.TextColor := $FF1C1915
  end
  if ReadText('rule') = '1' then begin
    RuleFine.Color := $FF1F6B4A
    RuleFine.TextColor := $FFF3FAF6
    RuleEven.Color := $FFFBF8F2
    RuleEven.TextColor := $FF1C1915
    RuleStrong.Color := $FFFBF8F2
    RuleStrong.TextColor := $FF1C1915
  end else if ReadText('rule') = '3' then begin
    RuleStrong.Color := $FF1F6B4A
    RuleStrong.TextColor := $FFF3FAF6
    RuleFine.Color := $FFFBF8F2
    RuleFine.TextColor := $FF1C1915
    RuleEven.Color := $FFFBF8F2
    RuleEven.TextColor := $FF1C1915
  end else begin
    RuleEven.Color := $FF1F6B4A
    RuleEven.TextColor := $FFF3FAF6
    RuleFine.Color := $FFFBF8F2
    RuleFine.TextColor := $FF1C1915
    RuleStrong.Color := $FFFBF8F2
    RuleStrong.TextColor := $FF1C1915
  end
  if ReadText('previews') = '0' then begin
    PreviewOff.Color := $FF1F6B4A
    PreviewOff.TextColor := $FFF3FAF6
    PreviewOn.Color := $FFFBF8F2
    PreviewOn.TextColor := $FF1C1915
  end else begin
    PreviewOn.Color := $FF1F6B4A
    PreviewOn.TextColor := $FFF3FAF6
    PreviewOff.Color := $FFFBF8F2
    PreviewOff.TextColor := $FF1C1915
  end
  if ReadText('page') = 'site' then begin
    PackSite.Color := $FF1F6B4A
    PackSite.TextColor := $FFF3FAF6
    PackThis.Color := $FFFBF8F2
    PackThis.TextColor := $FF1C1915
  end else begin
    PackThis.Color := $FF1F6B4A
    PackThis.TextColor := $FFF3FAF6
    PackSite.Color := $FFFBF8F2
    PackSite.TextColor := $FF1C1915
  end
  SizeSmaller.Color := $FFFBF8F2
  SizeSmaller.TextColor := $FF1C1915
  SizeSmall.Color := $FFFBF8F2
  SizeSmall.TextColor := $FF1C1915
  SizeRegular.Color := $FFFBF8F2
  SizeRegular.TextColor := $FF1C1915
  SizeLarge.Color := $FFFBF8F2
  SizeLarge.TextColor := $FF1C1915
  SizeLarger.Color := $FFFBF8F2
  SizeLarger.TextColor := $FF1C1915
  if ReadText('size') = 'smaller' then begin
    SizeSmaller.Color := $FF1F6B4A
    SizeSmaller.TextColor := $FFF3FAF6
  end else if ReadText('size') = 'regular' then begin
    SizeRegular.Color := $FF1F6B4A
    SizeRegular.TextColor := $FFF3FAF6
  end else if ReadText('size') = 'large' then begin
    SizeLarge.Color := $FF1F6B4A
    SizeLarge.TextColor := $FFF3FAF6
  end else if ReadText('size') = 'larger' then begin
    SizeLarger.Color := $FF1F6B4A
    SizeLarger.TextColor := $FFF3FAF6
  end else begin
    SizeSmall.Color := $FF1F6B4A
    SizeSmall.TextColor := $FFF3FAF6
  end
end;

procedure ShowCounts();
var
  Line: String;
begin
  NotesLabel.Text := IntToStr(LineCount(ReadText('titles')))
  MediaLabel.Text := IntToStr(LineCount(ReadText('lines-Image')) + LineCount(ReadText('lines-Video')))
  TrashCount.Text := IntToStr(LineCount(ReadText('trash'))) + ' in the trash'
  Line := 'Note ' + IntToStr(LineCount(ReadText('lines-Note')))
  Line := Line + '  Draft ' + IntToStr(LineCount(ReadText('lines-Draft')))
  Line := Line + '  Dream ' + IntToStr(LineCount(ReadText('lines-Dream')))
  Line := Line + '  Event ' + IntToStr(LineCount(ReadText('lines-Event')))
  Line := Line + '  Period ' + IntToStr(LineCount(ReadText('lines-Period')))
  Line := Line + '  Task ' + IntToStr(LineCount(ReadText('lines-Task')))
  Line := Line + '  Link ' + IntToStr(LineCount(ReadText('lines-Link')))
  Line := Line + '  Quote ' + IntToStr(LineCount(ReadText('lines-Quote')))
  Line := Line + '  Image ' + IntToStr(LineCount(ReadText('lines-Image')))
  Line := Line + '  Video ' + IntToStr(LineCount(ReadText('lines-Video')))
  ByType.Text := Line
end;

