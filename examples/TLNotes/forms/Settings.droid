procedure RestoreAll();
var
  Names, Kinds, Name, Kind, Titles, Line: String;
  Index: Integer;
begin
  Names := ReadText('trash')
  Kinds := ReadText('trash-kinds')
  if Names = '' then
    Toast('Trash is empty')
  else begin
    Index := 0
    while LineAt(Names, Index) <> '' do begin
      Name := LineAt(Names, Index)
      Kind := LineAt(Kinds, Index)
      if Kind = '' then
        Kind := 'Note'
      WriteText('has-' + Name, '1')
      Titles := ReadText('titles')
      if Titles = '' then
        Titles := Name
      else
        Titles := Titles + GapLabel.Text + Name
      WriteText('titles', Titles)
      Titles := ReadText('kinds')
      if Titles = '' then
        Titles := Kind
      else
        Titles := Titles + GapLabel.Text + Kind
      WriteText('kinds', Titles)
      Line := Time()
      Line := Line + '  ' + Kind
      Titles := ReadText('marks')
      if Titles = '' then
        Titles := Line
      else
        Titles := Titles + GapLabel.Text + Line
      WriteText('marks', Titles)
      Line := Today()
      Titles := ReadText('days')
      if Titles = '' then
        Titles := Line
      else
        Titles := Titles + GapLabel.Text + Line
      WriteText('days', Titles)
      Line := Today()
      Line := Line + '  ' + Time()
      WriteText('when-' + Name, Line)
      Titles := ReadText('lines-' + Kind)
      if Titles = '' then
        Titles := Name
      else
        Titles := Titles + GapLabel.Text + Name
      WriteText('lines-' + Kind, Titles)
      Ingest(Name, ReadText('note-' + Name), 'txt')
      Index := Index + 1
    end
    WriteText('trash', '')
    WriteText('trash-kinds', '')
    Toast('Restored')
    ShowCounts()
  end
end;

procedure Keep(Name: String; Kind: String; Body: String);
var
  Titles, Line: String;
begin
  if ReadText('has-' + Name) <> '1' then begin
    WriteText('note-' + Name, Body)
    WriteText('kind-' + Name, Kind)
    WriteText('has-' + Name, '1')
    Titles := ReadText('titles')
    if Titles = '' then
      Titles := Name
    else
      Titles := Titles + GapLabel.Text + Name
    WriteText('titles', Titles)
    Titles := ReadText('kinds')
    if Titles = '' then
      Titles := Kind
    else
      Titles := Titles + GapLabel.Text + Kind
    WriteText('kinds', Titles)
    Line := Time()
    Line := Line + '  ' + Kind
    Titles := ReadText('marks')
    if Titles = '' then
      Titles := Line
    else
      Titles := Titles + GapLabel.Text + Line
    WriteText('marks', Titles)
    Line := Today()
    Titles := ReadText('days')
    if Titles = '' then
      Titles := Line
    else
      Titles := Titles + GapLabel.Text + Line
    WriteText('days', Titles)
    Line := Today()
    Line := Line + '  ' + Time()
    WriteText('when-' + Name, Line)
    Titles := ReadText('lines-' + Kind)
    if Titles = '' then
      Titles := Name
    else
      Titles := Titles + GapLabel.Text + Name
    WriteText('lines-' + Kind, Titles)
    Ingest(Name, Body, 'txt')
  end
end;

procedure SampleClick();
begin
  Keep('A quiet room and a long table.', 'Dream', 'A quiet room and a long table.')
  Keep('Notes stay on the device.', 'Quote', 'Notes stay on the device.')
  Keep('The timeline starts here.', 'Note', 'The timeline starts here. Write a line and Add keeps it.')
  Keep('Keep the journal on this device.', 'Task', 'Keep the journal on this device.')
  Keep('TLNotes opened in Droide.', 'Event', 'TLNotes opened in Droide.')
  Toast('Sample loaded')
  ShowCounts()
end;
