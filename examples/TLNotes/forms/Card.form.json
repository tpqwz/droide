      "events": { "OnClick": "TrashClick" }
    },
    {
      "type": "Button",
      "name": "CloseButton",
      "left": 252, "top": 500, "width": 92, "height": 40,
      "props": { "Text": "Close", "TextSize": 14, "TextColor": "#6E665C", "Color": "#F3EFE6", "Dock": "Bottom" },
      "events": { "OnClick": "CloseClick" }
    }
