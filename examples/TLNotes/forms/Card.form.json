      "events": { "OnChange": "EndClick" }
    },
    {
      "type": "Label",
      "name": "WhenLine",
      "left": 16, "top": 48, "width": 328, "height": 22,
      "props": { "Text": "", "TextColor": "#6E665C", "TextSize": 13 },
      "events": {}
    },
    {
      "type": "Memo",
      "name": "BodyEdit",
      "left": 16, "top": 206, "width": 328, "height": 280,
      "props": { "Text": "", "TextSize": 18, "Color": "#F3EFE6", "TextColor": "#1C1915", "Dock": "Fill" },
      "events": {}
    },
    {
      "type": "Label",
      "name": "TitleLine",
      "left": 0, "top": -40, "width": 4, "height": 4,
      "props": { "Text": "", "TextColor": "#F3EFE6", "TextSize": 1 },
      "events": {}
    },
    {
      "type": "Label",
      "name": "DoneLabel",
      "left": 20, "top": 508, "width": 200, "height": 22,
      "props": { "Text": "", "TextColor": "#1F6B4A", "TextSize": 13, "Dock": "Bottom" },
      "events": {}
    },
    {
      "type": "Button",
      "name": "SaveButton",
      "left": 16, "top": 572, "width": 72, "height": 40,
      "props": { "Text": "Save", "TextSize": 14, "TextColor": "#1F6B4A", "Color": "#F3EFE6", "Dock": "Bottom" },
      "events": { "OnClick": "SaveClick" }
    },
    {
      "type": "Button",
      "name": "CopyButton",
      "left": 92, "top": 572, "width": 72, "height": 40,
      "props": { "Text": "Copy", "TextSize": 14, "TextColor": "#1F6B4A", "Color": "#F3EFE6", "Dock": "Bottom" },
      "events": { "OnClick": "CopyClick" }
    },
    {
      "type": "Button",
      "name": "ShareButton",
      "left": 168, "top": 572, "width": 80, "height": 40,
