{
  "name": "Card",
  "title": "Note",
  "background": "#F3EFE6",
  "width": 360,
  "height": 640,
  "events": { "OnCreate": "Start" },
  "components": [
    {
      "type": "Label",
      "name": "KindLine",
      "left": 20, "top": 12, "width": 120, "height": 22,
      "props": { "Text": "Draft", "TextColor": "#6E665C", "TextSize": 13 },
      "events": {}
    },
    {
      "type": "Spinner",
      "name": "KindSpin",
      "left": 140, "top": 8, "width": 200, "height": 36,
      "props": {
        "Items": "Note\nDraft\nDream\nEvent\nPeriod\nTask\nLink\nQuote",
        "Selection": 1,
        "Color": "#FBF8F2"
      },
      "events": { "OnItemSelected": "KindPick" }
    },
    {
      "type": "Date",
      "name": "WhenDate",
      "left": 16, "top": 78, "width": 328, "height": 120,
      "props": { "Year": 2026, "Month": 11, "Day": 11 },
      "events": { "OnChange": "DateClick" }
    },
    {
      "type": "Label",
      "name": "EndLabel",
      "left": 16, "top": 206, "width": 200, "height": 22,
      "props": { "Text": "Ends", "TextColor": "#6E665C", "TextSize": 13, "Visible": false },
      "events": {}
    },
    {
      "type": "Button",
      "name": "EndClear",
      "left": 220, "top": 200, "width": 120, "height": 36,
      "props": { "Text": "Clear", "TextSize": 14, "TextColor": "#1F6B4A", "Color": "#F3EFE6", "Visible": false },
      "events": { "OnClick": "ClearEnd" }
    },
    {
      "type": "Date",
      "name": "EndDate",
      "left": 16, "top": 236, "width": 328, "height": 110,
