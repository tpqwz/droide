uses Look;

procedure Start();
begin
  TitleLine.Text := Arg(0)
  BodyEdit.Text := Arg(1)
  KindLine.Text := Arg(2)
  WhenLine.Text := Arg(3)
  if Arg(2) = 'Note' then
    KindSpin.Selection := 0
  else if Arg(2) = 'Draft' then
    KindSpin.Selection := 1
  else if Arg(2) = 'Dream' then
    KindSpin.Selection := 2
  else if Arg(2) = 'Event' then
    KindSpin.Selection := 3
  else if Arg(2) = 'Period' then
    KindSpin.Selection := 4
  else if Arg(2) = 'Task' then
    KindSpin.Selection := 5
  else if Arg(2) = 'Link' then
    KindSpin.Selection := 6
  else if Arg(2) = 'Quote' then
    KindSpin.Selection := 7
  else if Arg(2) = 'Image' then begin
    KindSpin.Items := 'Image'
    KindSpin.Selection := 0
    KindSpin.Enabled := false
  end else if Arg(2) = 'Video' then begin
    KindSpin.Items := 'Video'
    KindSpin.Selection := 0
    KindSpin.Enabled := false
  end
  if Arg(2) = 'Task' then begin
    if ReadText('done-' + Arg(0)) = '1' then
      DoneLabel.Text := 'Done'
    else
      DoneLabel.Text := 'Open task'
  end else
    DoneLabel.Text := ''
  ShowEnd()
  LoadEnd()
  ApplyLook()
end;

procedure KindPick(Name: String);
var
  N: Integer;
  Old, Kinds, Marks, Line, Gap: String;
begin
  Old := KindLine.Text
  if Name = Old then
    KindLine.Text := Name
  else begin
    KindLine.Text := Name
    WriteText('kind-' + TitleLine.Text, Name)
    N := LineIndex(ReadText('titles'), TitleLine.Text)
    if N >= 0 then begin
      Kinds := ReadText('kinds')
      Kinds := ReplaceAt(Kinds, N, Name)
      WriteText('kinds', Kinds)
      Marks := ReadText('marks')
      if Marks <> '' then begin
        Line := Time()
        Line := Line + '  ' + Name
        Marks := ReplaceAt(Marks, N, Line)
        WriteText('marks', Marks)
      end
    end
    Line := ReadText('lines-' + Old)
    N := LineIndex(Line, TitleLine.Text)
    if N >= 0 then begin
      Line := DropAt(Line, N)
      WriteText('lines-' + Old, Line)
    end
    Gap := GapLabel.Text
    Line := ReadText('lines-' + Name)
    if Line = '' then
      Line := TitleLine.Text
    else
      Line := Line + Gap + TitleLine.Text
    WriteText('lines-' + Name, Line)
    Toast('Type kept')
  end
  ShowEnd()
end;

function MonthName(M: Integer): String;
begin
  if M = 1 then
    Result := 'January'
  else if M = 2 then
    Result := 'February'
  else if M = 3 then
    Result := 'March'
  else if M = 4 then
    Result := 'April'
  else if M = 5 then
    Result := 'May'
  else if M = 6 then
    Result := 'June'
  else if M = 7 then
    Result := 'July'
  else if M = 8 then
    Result := 'August'
  else if M = 9 then
    Result := 'September'
  else if M = 10 then
    Result := 'October'
  else if M = 11 then
    Result := 'November'
  else
    Result := 'December'
end;

procedure ShowEnd();
begin
  if KindLine.Text = 'Period' then begin
    EndLabel.Visible := true
    EndClear.Visible := true
    EndDate.Visible := true
  end else begin
    EndLabel.Visible := false
    EndClear.Visible := false
    EndDate.Visible := false
  end
end;

procedure LoadEnd();
var
  Stamp: String;
  Y: Integer;
begin
  Stamp := ReadText('end-' + TitleLine.Text)
  Y := DatePart(Stamp, 0)
  if Y <> 0 then begin
    EndDate.Year := Y
    EndDate.Month := DatePart(Stamp, 1)
    EndDate.Day := DatePart(Stamp, 2)
  end
end;

procedure DateClick();
var
  Y, M, D, N: Integer;
  Stamp, Days: String;
begin
  Y := WhenDate.Year
  M := WhenDate.Month
  D := WhenDate.Day
  Stamp := IntToStr(Y)
  Stamp := Stamp + ' '
  Stamp := Stamp + MonthName(M)
  Stamp := Stamp + ' '
  Stamp := Stamp + IntToStr(D)
  WriteText('when-' + TitleLine.Text, Stamp)
  WhenLine.Text := Stamp
  N := LineIndex(ReadText('titles'), TitleLine.Text)
  if N >= 0 then begin
    Days := ReadText('days')
    if Days <> '' then begin
      Days := ReplaceAt(Days, N, Stamp)
      WriteText('days', Days)
    end
  end
end;

procedure EndClick();
var
  Y, M, D: Integer;
  Stamp: String;
begin
  if KindLine.Text <> 'Period' then
    Y := 0
  else begin
    Y := EndDate.Year
    M := EndDate.Month
    D := EndDate.Day
    Stamp := IntToStr(Y)
    Stamp := Stamp + ' '
    Stamp := Stamp + MonthName(M)
    Stamp := Stamp + ' '
    Stamp := Stamp + IntToStr(D)
    WriteText('end-' + TitleLine.Text, Stamp)
    WriteText('ends', TitleLine.Text + ' ' + Time())
  end
end;

procedure ClearEnd();
begin
  WriteText('end-' + TitleLine.Text, '')
  WriteText('ends', TitleLine.Text + ' ' + Time())
end;

procedure SaveClick();
begin
  WriteText('note-' + TitleLine.Text, BodyEdit.Text)
  Toast('Saved')
end;

procedure CopyClick();
begin
  CopyText(BodyEdit.Text)
  Toast('Copied')
end;

procedure ShareClick();
begin
  Share(KindLine.Text + ': ' + BodyEdit.Text)
end;

procedure DoneClick();
begin
  if KindLine.Text <> 'Task' then
    Toast('Not a task')
  else begin
    WriteText('done-' + TitleLine.Text, '1')
    WriteText('dones', TitleLine.Text + ' ' + Time())
    DoneLabel.Text := 'Done'
    Toast('Done')
  end
end;

procedure TrashClick();
var
  N: Integer;
  Titles, Kinds, Marks, Line, Trash, TrashKinds: String;
begin
  Titles := ReadText('titles')
  N := LineIndex(Titles, TitleLine.Text)
  if N < 0 then
    Toast('Not in the timeline')
  else begin
    Titles := DropAt(Titles, N)
    WriteText('titles', Titles)
    Kinds := ReadText('kinds')
    Kinds := DropAt(Kinds, N)
    WriteText('kinds', Kinds)
    Marks := ReadText('marks')
    if Marks <> '' then begin
      Marks := DropAt(Marks, N)
      WriteText('marks', Marks)
    end
    Marks := ReadText('days')
    if Marks <> '' then begin
      Marks := DropAt(Marks, N)
      WriteText('days', Marks)
    end
    Line := ReadText('lines-' + KindLine.Text)
    N := LineIndex(Line, TitleLine.Text)
    if N >= 0 then begin
      Line := DropAt(Line, N)
      WriteText('lines-' + KindLine.Text, Line)
    end
    Trash := ReadText('trash')
    TrashKinds := ReadText('trash-kinds')
    if Trash = '' then begin
      Trash := TitleLine.Text
      TrashKinds := KindLine.Text
    end else begin
      Trash := Trash + GapLabel.Text + TitleLine.Text
      TrashKinds := TrashKinds + GapLabel.Text + KindLine.Text
    end
    WriteText('trash', Trash)
    WriteText('trash-kinds', TrashKinds)
    Toast('Moved to trash')
    Finish()
  end
end;

procedure CloseClick();
begin
  Finish()
end;

procedure ApplyLook();
var
  Index, N, Theme: Integer;
begin
  if ReadText('scheme') = '' then
    Index := 0
  else if IsInt(ReadText('scheme')) then
    Index := StrToInt(ReadText('scheme'))
  else
    Index := 0
  if ReadText('theme') = '' then
    Theme := 0
  else if IsInt(ReadText('theme')) then
    Theme := StrToInt(ReadText('theme'))
  else
    Theme := 0
  N := Cast(Theme, Index, 0)
  Page(N)
  if (Theme = 16) or (Theme = 7) then
    BodyEdit.Color := Cast(Theme, Index, 1)
  else
    BodyEdit.Color := N
  SaveButton.Color := N
  CopyButton.Color := N
  ShareButton.Color := N
  TrashButton.Color := N
  CloseButton.Color := N
  N := Cast(Theme, Index, 1)
  KindSpin.Color := N
  N := Cast(Theme, Index, 2)
  BodyEdit.TextColor := N
  N := Cast(Theme, Index, 3)
  KindLine.TextColor := N
  WhenLine.TextColor := N
  EndLabel.TextColor := N
  TrashButton.TextColor := N
  CloseButton.TextColor := N
  if Theme = 16 then begin
    KindLine.TextColor := $FFF6E4C2
    WhenLine.TextColor := $FFE8C070
    EndLabel.TextColor := $FFE8C070
    TrashButton.TextColor := $FFF6E4C2
    CloseButton.TextColor := $FFF6E4C2
  end else if Theme = 7 then begin
    KindLine.TextColor := $FFEFE4CF
    WhenLine.TextColor := $FFC4B08A
    EndLabel.TextColor := $FFC4B08A
    TrashButton.TextColor := $FFEFE4CF
    CloseButton.TextColor := $FFEFE4CF
  end
  N := Cast(Theme, Index, 4)
  DoneLabel.TextColor := N
  SaveButton.TextColor := N
  CopyButton.TextColor := N
  ShareButton.TextColor := N
  DoneButton.Color := N
  N := Cast(Theme, Index, 5)
  DoneButton.TextColor := N
  N := TypeSize(ReadText('size'))
  BodyEdit.TextSize := N
end;
