uses Look;

procedure Open();
begin
  TrashList.Items := ReadText('trash')
  if ReadText('trash-kinds') <> '' then
    TrashList.Details := ReadText('trash-kinds')
  ApplyLook()
end;

procedure Restore(Name: String);
var
  N: Integer;
  Titles, Kinds, Kind, Body, Gap, Marks, Line: String;
begin
  Titles := ReadText('trash')
  N := LineIndex(Titles, Name)
  if N < 0 then
    Toast('Not in the trash')
  else begin
    Kinds := ReadText('trash-kinds')
    Kind := LineAt(Kinds, N)
    if Kind = '' then
      Kind := 'Note'
    Body := ReadText('note-' + Name)
    Gap := GapLabel.Text
    Titles := ReadText('titles')
    if Titles = '' then
      Titles := Name
    else
      Titles := Titles + Gap + Name
    WriteText('titles', Titles)
    Kinds := ReadText('kinds')
    if Kinds = '' then
      Kinds := Kind
    else
      Kinds := Kinds + Gap + Kind
    WriteText('kinds', Kinds)
    Marks := ReadText('marks')
    Line := Time()
    Line := Line + '  ' + Kind
    if Marks = '' then
      Marks := Line
    else
      Marks := Marks + Gap + Line
    WriteText('marks', Marks)
    Line := ReadText('lines-' + Kind)
    if Line = '' then
      Line := Name
    else
      Line := Line + Gap + Name
    WriteText('lines-' + Kind, Line)
    Line := Today()
    Line := Line + '  ' + Time()
    WriteText('when-' + Name, Line)
    Line := ReadText('days')
    Marks := Today()
    if Line = '' then
      Line := Marks
    else
      Line := Line + Gap + Marks
    WriteText('days', Line)
    Ingest(Name, Body, 'txt')
    Titles := ReadText('trash')
    Titles := DropAt(Titles, N)
    WriteText('trash', Titles)
    Kinds := ReadText('trash-kinds')
    Kinds := DropAt(Kinds, N)
    WriteText('trash-kinds', Kinds)
    TrashList.Items := ReadText('trash')
    Kinds := ReadText('trash-kinds')
    if Kinds <> '' then
      TrashList.Details := Kinds
    ApplyLook()
    Toast('Restored')
  end
end;

procedure EmptyClick();
begin
  WriteText('trash', '')
  WriteText('trash-kinds', '')
  TrashList.Items := ''
  TrashList.Details := ''
  ApplyLook()
  Toast('Trash emptied')
end;

procedure CloseClick();
begin
  Finish()
end;

procedure ApplyLook();
var
  Index, N, Theme: Integer;
begin
  if ReadText('scheme') = '' then
    Index := 0
  else if IsInt(ReadText('scheme')) then
    Index := StrToInt(ReadText('scheme'))
  else
    Index := 0
  if ReadText('theme') = '' then
    Theme := 0
  else if IsInt(ReadText('theme')) then
    Theme := StrToInt(ReadText('theme'))
  else
    Theme := 0
  N := Cast(Theme, Index, 0)
  Page(N)
  TrashList.Color := N
  TrashList.Paper := N
  CloseButton.Color := N
  N := Cast(Theme, Index, 1)
  TrashList.Card := N
  EmptyButton.Color := N
  N := Cast(Theme, Index, 2)
  TrashList.Ink := N
  EmptyButton.TextColor := N
  if Theme = 16 then
    TitleLabel.TextColor := $FFF6E4C2
  else if Theme = 7 then
    TitleLabel.TextColor := $FFEFE4CF
  else
    TitleLabel.TextColor := N
  N := Cast(Theme, Index, 3)
  TrashList.Muted := N
  if Theme = 16 then
    About.TextColor := $FFE8C070
  else if Theme = 7 then
    About.TextColor := $FFC4B08A
  else
    About.TextColor := N
  N := Cast(Theme, Index, 4)
  CloseButton.TextColor := N
  N := TypeSize(ReadText('size'))
  TrashList.RowSize := N
  TitleLabel.TextSize := N + 7
end;
