{ Catalog 7, Blueprint 8, Terminal 9, Pocket 14, Dungeon 15, and Tavern 16 paint their own page. }
function Cast(Theme, Scheme, Slot: Integer): Integer;
begin
  if Theme = 7 then begin
    if Slot = 0 then
      Result := $FF65584C
    else if Slot = 1 then
      Result := $FFF7F1E4
    else if Slot = 2 then
      Result := $FF2A2118
    else if Slot = 3 then
      Result := $FF6E4B32
    else if Slot = 4 then
      Result := $FFB42318
    else if Slot = 5 then
      Result := $FFFFF6F2
    else if Slot = 6 then
      Result := $FFB7A78C
    else
      Result := $FF3E362E
  end else if Theme = 8 then begin
    if Slot = 0 then
      Result := $FF0B3A66
    else if Slot = 1 then
      Result := $FF082C4E
    else if Slot = 2 then
      Result := $FFE7F2FF
    else if Slot = 3 then
      Result := $FF9EC4E8
    else if Slot = 4 then
      Result := $FFFFFFFF
    else if Slot = 5 then
      Result := $FF0B3A66
    else if Slot = 6 then
      Result := $FF7EB6E6
    else
      Result := $FF082C4E
  end else if Theme = 9 then begin
    if Slot = 0 then
      Result := $FF031406
    else if Slot = 1 then
      Result := $FF031406
    else if Slot = 2 then
      Result := $FF7CFF6B
    else if Slot = 3 then
      Result := $FF3D9A45
    else if Slot = 4 then
      Result := $FFB6FF9A
    else if Slot = 5 then
      Result := $FF031406
    else if Slot = 6 then
      Result := $FF1F6B32
    else
      Result := $FF05210C
  end else if Theme = 14 then begin
    if Slot = 0 then
      Result := $FF8BAC0F
    else if Slot = 1 then
      Result := $FF9BBC0F
    else if Slot = 2 then
      Result := $FF0F380F
    else if Slot = 3 then
      Result := $FF306230
    else if Slot = 4 then
      Result := $FF0F380F
    else if Slot = 5 then
      Result := $FF9BBC0F
    else if Slot = 6 then
      Result := $FF306230
    else
      Result := $FF306230
  end else if Theme = 15 then begin
    if Slot = 0 then
      Result := $FF101018
    else if Slot = 1 then
      Result := $FF16162A
    else if Slot = 2 then
      Result := $FFF0E6C8
    else if Slot = 3 then
      Result := $FFC4B496
    else if Slot = 4 then
      Result := $FFE8C547
    else if Slot = 5 then
      Result := $FF1A1208
    else if Slot = 6 then
      Result := $FF6E5C38
    else
      Result := $FF1A1208
  end else if Theme = 16 then begin
    if Slot = 0 then
      Result := $FF3A2415
    else if Slot = 1 then
      Result := $FFF3E6C8
    else if Slot = 2 then
      Result := $FF2A140C
    else if Slot = 3 then
      Result := $FF6B4428
    else if Slot = 4 then
      Result := $FFE07040
    else if Slot = 5 then
      Result := $FF2A140C
    else if Slot = 6 then
      Result := $FF6B4428
    else
      Result := $FF2A1810
  end else
    Result := Tone(Scheme, Slot)
end;

function TypeSize(Name: String): Integer;
begin
  if Name = 'smaller' then
    Result := 13
  else if Name = 'regular' then
    Result := 18
  else if Name = 'large' then
    Result := 20
  else if Name = 'larger' then
    Result := 24
  else
    Result := 15
end;

function RuleDp(Name: String): Integer;
begin
  if Name = '1' then
    Result := 1
  else if Name = '3' then
    Result := 4
  else
    Result := 2
end;
